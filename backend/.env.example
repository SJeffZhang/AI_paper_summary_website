# Local development example.
# Production GitHub Actions deploys render backend/.env from GitHub production secrets
# using deploy/linux/backend.env.production.template.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_paper_summary
MYSQL_UNIX_SOCKET=

BACKEND_PUBLIC_URL=https://your-backend.example.com
FRONTEND_URL=https://your-frontend.example.com

DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TIMEOUT_SECONDS=60
LLM_LONGFORM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
LLM_LONGFORM_MAX_RETRIES=2
LLM_MIN_REQUEST_INTERVAL_SECONDS=1
LLM_LONGFORM_MIN_REQUEST_INTERVAL_SECONDS=2
LLM_EDITOR_MAX_TOKENS=4096
LLM_WRITER_FOCUS_MAX_TOKENS=4096
LLM_WRITER_WATCHING_MAX_TOKENS=4096
LLM_REVIEWER_MAX_TOKENS=2048
LLM_ABSTRACT_MAX_CHARS=16000
LLM_TITLE_LOCALIZATION_ATTEMPTS=3
LLM_TITLE_BATCH_SIZE=8
PIPELINE_MAX_CATEGORY_ATTEMPTS=30
PIPELINE_FOCUS_ATTEMPT_MULTIPLIER=4
PIPELINE_WATCHING_ATTEMPT_MULTIPLIER=2
PIPELINE_ENABLE_WATCHING=true
PIPELINE_REVIEWER_STRICT=true
PIPELINE_PROBE_DAYS=14

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=AI Paper Summary
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
OWNER_ALERT_EMAIL=z1332556430@gmail.com
SEMANTIC_SCHOLAR_TIMEOUT_SECONDS=5
CRAWLER_CITATION_MAX_WORKERS=16
